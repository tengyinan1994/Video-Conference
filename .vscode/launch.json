{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LiveKit (本机 7880, IP 自动)",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash \"${workspaceFolder}/deploy/dev-livekit.sh\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "LiveKit (Compose 17880)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose -f \"${workspaceFolder}/deploy/docker-compose.yml\" --env-file \"${workspaceFolder}/deploy/.env\" up livekit",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "HotGo API (Air)",
      "type": "node-terminal",
      "request": "launch",
      "command": "air",
      "cwd": "${workspaceFolder}/server/backend"
    },
    {
      "name": "HotGo Web",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/server/web"
    },
    {
      "name": "Client (Vite)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/client"
    },
    {
      "name": "Client (Tauri)",
      "type": "node-terminal",
      "request": "launch",
      "command": "source \"$HOME/.cargo/env\" && pnpm tauri:dev",
      "cwd": "${workspaceFolder}/client"
    },
    {
      "name": "HotGo API (Delve 断点调试)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/server/backend",
      "args": ["http"],
      "cwd": "${workspaceFolder}/server/backend",
      "showLog": true
    }
  ],
  "compounds": [
    {
      "name": "启动全部",
      "configurations": [
        "LiveKit (本机 7880, IP 自动)",
        "HotGo API (Air)",
        "HotGo Web",
        "Client (Vite)"
      ],
      "stopAll": true,
      "presentation": {
        "order": 1,
        "group": "video-conference",
        "hidden": false
      }
    },
    {
      "name": "仅开会（不含管理后台）",
      "configurations": ["LiveKit (本机 7880, IP 自动)", "HotGo API (Air)", "Client (Vite)"],
      "stopAll": true,
      "presentation": {
        "order": 2,
        "group": "video-conference",
        "hidden": false
      }
    },
    {
      "name": "仅开会（Tauri 壳）",
      "configurations": ["LiveKit (本机 7880, IP 自动)", "HotGo API (Air)", "Client (Tauri)"],
      "stopAll": true,
      "presentation": {
        "order": 3,
        "group": "video-conference",
        "hidden": false
      }
    }
  ]
}
