# 复制为 deploy/test/.env 后按需修改

# SSH 与远端目录
DEPLOY_HOST=dept
REMOTE_DIR=/data/video-conference
DATA_DIR=/data/video-conference/data
PUBLIC_HOST=125.211.217.19

# 镜像架构（与 build-amd64.sh 一致）
ARCH=amd64
LIVEKIT_IMAGE=video-conference/livekit:amd64

# LiveKit ICE 宣告 IP（公网/可达 IP，与 livekit.url 一致）
LIVEKIT_NODE_IP=125.211.217.19
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecret12

# 对外端口（会议与管理后台分端口）
LIVEKIT_SIGNAL_PORT=17880
LIVEKIT_RTC_TCP_PORT=17881
LIVEKIT_RTC_UDP_PORT=17882
ADMIN_PORT=17883
ADMIN_HTTP_PORT=17884
CLIENT_PORT=17885
CLIENT_HTTP_PORT=17888

# RustFS
RUSTFS_PORT=17886
RUSTFS_CONSOLE_PORT=17887
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=recordings

# MySQL（需与 config/config.yaml 中 database.default.link 一致）
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=video_conference
MYSQL_USER=video_conference
MYSQL_PASSWORD=hg123456.
