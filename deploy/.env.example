# 复制为 deploy/.env 后按需修改（.env 已被根 .gitignore 忽略）

# 镜像架构：amd64 | arm64（需先执行对应 build-*.sh）
ARCH=amd64

# LiveKit 镜像：打包后一般为 video-conference/livekit:arm64 或 amd64
LIVEKIT_IMAGE=video-conference/livekit:arm64

# LiveKit ICE 宣告 IP：填宿主机局域网 IP，勿用 127.0.0.1（第二台设备会连不上）
LIVEKIT_NODE_IP=127.0.0.1

# LiveKit API（需与 deploy/config/config.yaml 中 livekit.apiKey / apiSecret 一致；secret ≥ 32 字符）
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecret12

# 仅对外暴露的宿主机端口（mysql/redis/HotGo TCP 不映射，走 compose 内网）
# - LIVEKIT_SIGNAL_PORT：信令 WS → HotGo livekit.url，如 ws://IP:17880
# - LIVEKIT_RTC_*_PORT：媒体口；容器监听 = 宿主机映射 = ICE 宣告
LIVEKIT_SIGNAL_PORT=17880
LIVEKIT_RTC_TCP_PORT=17881
LIVEKIT_RTC_UDP_PORT=17882
HOTGO_PORT=17883
CLIENT_PORT=17885
# 可选：HTTP 入口，会 301 到 HTTPS（摄像头需要安全上下文）
CLIENT_HTTP_PORT=17888

# MySQL（容器内网；需与 config/config.yaml 中 database.default.link 一致）
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=video_conference
MYSQL_USER=video_conference
MYSQL_PASSWORD=hg123456.
